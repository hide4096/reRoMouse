%% ============================================================
%  差分方程式の安全実装版（インデックスエラー対策済み）
% ============================================================
%clear; close all; clc;

% ---- 伝達関数係数設定 ----
b = [0.01 -0.01777 7.798e-];
a = [0.289 -0.5722 0.2832];

% ---- 正規化 ----
a0 = a(1);
b = b / a0;
a = a / a0;

% ---- シミュレーション設定 ----
Ts = 0.001;
N = 1000;
r = ones(N, 1);    % ステップ入力
u = zeros(N, 1);   % 出力初期化

% ---- 差分方程式の逐次計算 ----
for k = 1:N
    % 安全に過去値を取得（範囲外なら0）
    if k >= 2
        r1 = r(k-1);
        u1 = u(k-1);
    else
        r1 = 0;
        u1 = 0;
    end
    if k >= 3
        r2 = r(k-2);
        u2 = u(k-2);
    else
        r2 = 0;
        u2 = 0;
    end
    
    % 差分方程式
    % u[k] = -a1*u[k-1] - a2*u[k-2] + b0*r[k] + b1*r[k-1] + b2*r[k-2]
    u(k) = -a(2)*u1 - a(3)*u2 + b(1)*r(k) + b(2)*r1 + b(3)*r2;
end

% ---- MATLABのfilter関数での比較 ----
u_filter = filter(b, a, r);

% ---- tfモデルとの比較 ----
Fz = tf(b, a, Ts);
[y_tf, t_tf] = step(Fz, N);

% ---- プロット ----
time = (0:N-1)' * Ts;
figure;
%plot(time, u_filter, 'b-', 'LineWidth', 1.3); 
hold on;
plot(time, u, 'k--', 'LineWidth', 1.3);
plot(t_tf, y_tf, 'r:', 'LineWidth', 1.5);
legend('filter(b,a,r)', 'manual diff-eq', 'step(Fz)');
xlabel('Time [s]'); ylabel('Output');
title('差分実装 vs filter vs tf(step)');
grid on;
